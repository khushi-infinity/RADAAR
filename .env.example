# Copy this file to .env and fill in values — .env is gitignored, never commit it

# --- Cognee (merchant memory / knowledge graph) ---
# Key from https://console.cognee.ai → API Keys (also copy the Base URL shown there)
COGNEE_API_KEY=
COGNEE_BASE_URL=
COGNEE_TENANT_ID=
COGNEE_USER_ID=

# --- n8n (orchestration) ---
# From your n8n → Settings → n8n API → Create an API key
N8N_BASE_URL=https://<your-instance>.app.n8n.cloud/
N8N_API_KEY=

# --- Sarvam AI (vernacular copilot: chat + TTS + STT) ---
# From https://dashboard.sarvam.ai → API Keys
SARVAM_API_KEY=

# --- Paytm sandbox (optional garnish — demo runs on synthetic data) ---
PAYTM_MID=
PAYTM_MERCHANT_KEY=

# NOTE: no OpenAI key needed — Cognee Cloud bills LLM usage from its own credits.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
